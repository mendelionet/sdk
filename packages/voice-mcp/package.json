{
  "name": "mendelio-voice-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Mendelio Voice API — generate speech and clone voices from Claude, Codex, Cursor and other MCP clients.",
  "license": "MIT",
  "type": "module",
  "author": "Mendelio",
  "homepage": "https://voice.mendelio.net/developers",
  "repository": { "type": "git", "url": "https://github.com/mendelionet/sdk.git", "directory": "packages/voice-mcp" },
  "keywords": ["mcp", "model-context-protocol", "mendelio", "voice", "tts", "text-to-speech"],
  "engines": { "node": ">=18" },
  "bin": { "mendelio-voice-mcp": "./dist/index.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "import": "./dist/core.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "prebuild": "pnpm --filter mendelio-voice build",
    "build": "tsup",
    "pretypecheck": "pnpm --filter mendelio-voice build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter mendelio-voice build",
    "test": "vitest run",
    "test:authenticated": "pnpm build && node scripts/authenticated-smoke.mjs",
    "test:remote-auth": "node scripts/remote-auth-smoke.mjs",
    "test:stdio": "pnpm build && node scripts/stdio-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mendelio-voice": "workspace:0.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
