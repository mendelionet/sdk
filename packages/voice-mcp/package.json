{
  "name": "mendelio-voice-mcp",
  "version": "0.1.4",
  "description": "Public Preview: Generate and play speech with Hezky česky. Choose from 190+ unique voices—including people, creatures, dragons, and robots—or create a personal voice from an authorized recording.",
  "mcpName": "io.github.mendelionet/mendelio-voice",
  "license": "MIT",
  "type": "module",
  "author": "Mendelio",
  "homepage": "https://voice.mendelio.net/developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/mendelionet/sdk.git",
    "directory": "packages/voice-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mendelio",
    "voice",
    "hezky-cesky",
    "czech",
    "czech-tts",
    "tts",
    "text-to-speech",
    "voice-cloning"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mendelio-voice-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:metadata": "node scripts/sync-metadata.mjs --check",
    "prebuild": "pnpm check:metadata && pnpm --filter mendelio-voice build",
    "build": "tsup",
    "pretypecheck": "pnpm check:metadata && pnpm --filter mendelio-voice build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm check:metadata && pnpm --filter mendelio-voice build",
    "test": "vitest run",
    "test:authenticated": "pnpm build && node scripts/authenticated-smoke.mjs",
    "test:remote-auth": "node scripts/remote-auth-smoke.mjs",
    "test:stdio": "pnpm build && node scripts/stdio-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mendelio-voice": "workspace:0.1.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
