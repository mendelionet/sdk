{
  "name": "mendelio-voice",
  "version": "0.1.3",
  "description": "Official TypeScript SDK for the Mendelio Voice API — generate natural speech, clone voices, poll async work, verify webhooks.",
  "license": "MIT",
  "type": "module",
  "author": "Mendelio",
  "homepage": "https://voice.mendelio.net/developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/mendelionet/sdk.git",
    "directory": "packages/voice"
  },
  "keywords": [
    "mendelio",
    "voice",
    "tts",
    "text-to-speech",
    "czech",
    "speech",
    "voice-cloning"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mendelio-voice": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "require": "./dist/identity.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "node scripts/contract-smoke.mjs",
    "test:live-negative": "pnpm build && node scripts/live-negative-smoke.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
