{
  "name": "mendelio-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "changeset": "changeset",
    "sync:mcp-metadata": "node packages/voice-mcp/scripts/sync-metadata.mjs --write",
    "check:mcp-metadata": "node packages/voice-mcp/scripts/sync-metadata.mjs --check",
    "version-packages": "changeset version && pnpm sync:mcp-metadata",
    "release": "pnpm check:mcp-metadata && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "typescript": "^5.6.0"
  }
}
